# ============================
# GenPosFit — Environment
# ============================

# Database
DB_NAME=genposfit
DB_USER=genposfit_user
DB_PASSWORD=genposfit_secret
DB_ROOT_PASSWORD=root_secret
DB_PORT=3348

# Backend
BACKEND_PORT=8042

# Frontend
FRONTEND_PORT=3042

# PhpMyAdmin
PMA_PORT=8122

# API Proxy target (dipakai Vite dev server di dalam Docker).
# Ini harus mengarah ke service backend pada jaringan Docker, bukan localhost browser.
# Untuk development non-Docker di host, set VITE_API_PROXY=http://127.0.0.1:8042
VITE_API_URL=
VITE_API_PROXY=http://backend:8042

# HTTPS dev-server untuk KAMERA via IP host. getUserMedia browser hanya aktif
# di secure context (https:// atau localhost). Container frontend otomatis
# membuat self-signed cert (scripts/gen-certs.sh) dan serve https://:3042.
# Isi CERT_HOSTS dengan IP/DNS yang dipakai browser user (opsional, utk SAN cert):
# CERT_HOSTS="192.168.1.42 genposfit.local"
CERT_HOSTS=

# GPC — GenPosFit Coin (ERC-1155, Sepolia)
SEPOLIA_RPC_URL="https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID"
PRIVATE_KEY="YOUR_DEPLOYER_PRIVATE_KEY"
ETHERSCAN_API_KEY="YOUR_ETHERSCAN_API_KEY"
