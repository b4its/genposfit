# ============================
# GenPosFit — Environment
# ============================

# Database
DB_NAME=genposfit
DB_USER=genposfit_user
DB_PASSWORD=genposfit_secret
DB_ROOT_PASSWORD=root_secret
DB_PORT=3348

# Backend
BACKEND_PORT=8042

# Frontend
FRONTEND_PORT=3042

# PhpMyAdmin
PMA_PORT=8122

# API Proxy target (dipakai Vite dev server di dalam Docker).
# Ini harus mengarah ke service backend pada jaringan Docker, bukan localhost browser.
# Untuk development non-Docker di host, set VITE_API_PROXY=http://127.0.0.1:8042
VITE_API_URL=
VITE_API_PROXY=http://backend:8042

# URL API absolut (opsional). Kosong = same-origin (window.location.origin) →
# request /api lewat proxy Vite/server frontend ke backend. Ini menghindari
# CORS, mixed-content, dan tidak pernah menembak localhost browser client.
# Hanya set bila backend berada di origin berbeda dari frontend,
# mis. VITE_API_URL=http://10.160.116.16:8042
VITE_API_URL=

# HTTPS dev-server untuk KAMERA via IP host (getUserMedia = secure context:
# https:// atau http://localhost; IP host via http:// akan DIBLOKIR browser).
#   VITE_HTTPS=0 → frontend HTTP biasa: http://localhost:3042 (kamera di
#                  localhost tetap jalan; akses IP host: kamera diblokir).
#   VITE_HTTPS=1 → container generate/pakai self-signed cert (scripts/gen-certs.sh)
#                  dan serve https://localhost:3042 + https://<ip-host>:3042.
#                  Accept warning sekali (Advanced → Proceed), kamera aktif.
#   PENTING: saat =1, buka https://… — akses http://… membuat ERR_EMPTY_RESPONSE.
VITE_HTTPS=1

# IP/DNS host yang diketik user di browser (untuk SAN cert HTTPS). Container
# tidak dapat auto-detect IP LAN host → isi manual:
#   CERT_HOSTS="10.160.116.16 192.168.1.50"
CERT_HOSTS="10.160.116.16"

# GPC — GenPosFit Coin (ERC-1155, Sepolia)
SEPOLIA_RPC_URL="https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID"
PRIVATE_KEY="YOUR_DEPLOYER_PRIVATE_KEY"
ETHERSCAN_API_KEY="YOUR_ETHERSCAN_API_KEY"
